      "challenges": [
        {
          "id": "color-palette",
          "day": 4,
          "title": "Color Palette",
          "goal": "Design a 5-color palette for a 'sunset' theme.",
          "hint": "Fill the 5 .swatch elements with a warm, distinct palette (oranges, pinks, purples).",
          "starter": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<style>\nbody { font-family: system-ui; padding: 20px; }\n  .palette { display: flex; gap: 10px; }\n  .swatch { flex: 1; height: 90px; border-radius: 10px; border: 1px solid #ccc; }\n  /* Give the 5 swatches a warm \"sunset\" palette: */\n</style>\n</head>\n<body>\n<p>Sunset palette</p>\n  <div class=\"palette\">\n    <div class=\"swatch\"></div><div class=\"swatch\"></div><div class=\"swatch\"></div>\n    <div class=\"swatch\"></div><div class=\"swatch\"></div>\n  </div>\n</body>\n</html>\n",
          "solution": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<style>\nbody { font-family: system-ui; padding: 20px; }\n  .palette { display: flex; gap: 10px; }\n  .swatch { flex: 1; height: 90px; border-radius: 10px; border: 1px solid #ccc; }\n  .swatch:nth-child(1) { background: #ff5e3a; }\n  .swatch:nth-child(2) { background: #ff8c42; }\n  .swatch:nth-child(3) { background: #ffc94d; }\n  .swatch:nth-child(4) { background: #ff9eb5; }\n  .swatch:nth-child(5) { background: #8e3b8f; }\n</style>\n</head>\n<body>\n<p>Sunset palette</p>\n  <div class=\"palette\">\n    <div class=\"swatch\"></div><div class=\"swatch\"></div><div class=\"swatch\"></div>\n    <div class=\"swatch\"></div><div class=\"swatch\"></div>\n  </div>\n</body>\n</html>\n"
        },
        {
          "id": "hsl-rainbow",
          "day": 5,
          "title": "HSL Rainbow",
          "goal": "Make a rainbow using hsl() — 7 stripes, red to violet.",
          "hint": "Give each .stripe a background in hsl() with a different hue, using the nth-child pattern.",
          "starter": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<style>\nbody { font-family: system-ui; padding: 20px; }\n  .rainbow { display: grid; gap: 4px; }\n  .stripe { height: 34px; }\n  /* Give each stripe a hue using hsl(), from red to violet: */\n</style>\n</head>\n<body>\n<p>Rainbow in hsl()</p>\n  <div class=\"rainbow\">\n    <div class=\"stripe\"></div>\n    <div class=\"stripe\"></div>\n    <div class=\"stripe\"></div>\n    <div class=\"stripe\"></div>\n    <div class=\"stripe\"></div>\n    <div class=\"stripe\"></div>\n    <div class=\"stripe\"></div>\n  </div>\n</body>\n</html>\n",
          "solution": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<style>\nbody { font-family: system-ui; padding: 20px; }\n  .rainbow { display: grid; gap: 4px; }\n  .stripe { height: 34px; }\n  .stripe:nth-child(1) { background: hsl(0 100% 60%); }\n  .stripe:nth-child(2) { background: hsl(60 100% 60%); }\n  .stripe:nth-child(3) { background: hsl(120 100% 60%); }\n  .stripe:nth-child(4) { background: hsl(180 100% 60%); }\n  .stripe:nth-child(5) { background: hsl(240 100% 60%); }\n  .stripe:nth-child(6) { background: hsl(300 100% 60%); }\n  .stripe:nth-child(7) { background: hsl(330 100% 60%); }\n</style>\n</head>\n<body>\n<p>Rainbow in hsl()</p>\n  <div class=\"rainbow\">\n    <div class=\"stripe\"></div>\n    <div class=\"stripe\"></div>\n    <div class=\"stripe\"></div>\n    <div class=\"stripe\"></div>\n    <div class=\"stripe\"></div>\n    <div class=\"stripe\"></div>\n    <div class=\"stripe\"></div>\n  </div>\n</body>\n</html>\n"
        },
        {
          "id": "dark-mode",
          "day": 6,
          "title": "Dark Mode Toggle",
          "goal": "Build a button that switches CSS variables between light and dark themes.",
          "hint": "Add a click listener on #toggle that toggles the 'dark' class on <html>.",
          "starter": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<style>\n:root { --bg: #ffffff; --fg: #111111; }\n  :root.dark { --bg: #12141a; --fg: #f1f3f9; }\n  body { background: var(--bg); color: var(--fg); margin: 0; font-family: system-ui; padding: 20px; }\n  button { padding: 8px 14px; border-radius: 8px; cursor: pointer; border: 1px solid #ccc; }\n</style>\n</head>\n<body>\n<button id=\"toggle\">Toggle dark mode</button>\n  <p>This page is theme-aware.</p>\n\n<script>\n// Add a click listener that toggles the \"dark\" class on <html>:\n\n</script>\n</body>\n</html>\n",
          "solution": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<style>\n:root { --bg: #ffffff; --fg: #111111; }\n  :root.dark { --bg: #12141a; --fg: #f1f3f9; }\n  body { background: var(--bg); color: var(--fg); margin: 0; font-family: system-ui; padding: 20px; }\n  button { padding: 8px 14px; border-radius: 8px; cursor: pointer; border: 1px solid #ccc; }\n</style>\n</head>\n<body>\n<button id=\"toggle\">Toggle dark mode</button>\n  <p>This page is theme-aware.</p>\n\n<script>\ndocument.getElementById(\"toggle\").addEventListener(\"click\", () => {\n  document.documentElement.classList.toggle(\"dark\");\n});\n\n</script>\n</body>\n</html>\n"
        },
        {
          "id": "accessible-contrast",
          "day": 7,
          "title": "Accessible Contrast",
          "goal": "Fix 3 sections that fail WCAG contrast (target 4.5:1 — you can use a contrast checker).",
          "hint": "Make the text dark enough against each background. Contrast must be at least 4.5:1.",
          "starter": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<style>\nbody { font-family: system-ui; padding: 20px; }\n  .section { border-radius: 10px; padding: 18px; margin-bottom: 14px; }\n  .section p { margin: 0; }\n  .s1 { color: #9a9a9a; background: #ffffff; }\n  .s2 { color: #c0c0c0; background: #f2f2f2; }\n  .s3 { color: #a7b0c8; background: #eef2fa; }\n  /* These 3 fail WCAG AA (4.5:1). Raise the contrast of each. */\n</style>\n</head>\n<body>\n<section class=\"section s1\"><p>Primary text</p></section>\n  <section class=\"section s2\"><p>Secondary text</p></section>\n  <section class=\"section s3\"><p>Tertiary text</p></section>\n</body>\n</html>\n",
          "solution": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<style>\nbody { font-family: system-ui; padding: 20px; }\n  .section { border-radius: 10px; padding: 18px; margin-bottom: 14px; }\n  .section p { margin: 0; }\n  .s1 { color: #1a1a1a; background: #ffffff; }\n  .s2 { color: #24292e; background: #f2f2f2; }\n  .s3 { color: #23304f; background: #eef2fa; }\n</style>\n</head>\n<body>\n<section class=\"section s1\"><p>Primary text</p></section>\n  <section class=\"section s2\"><p>Secondary text</p></section>\n  <section class=\"section s3\"><p>Tertiary text</p></section>\n</body>\n</html>\n"
        }
      ]
    },
    {
      "level": 3,
      "name": "Applied",
      "days": "Days 8–12",
      "challenges": [
        {
          "id": "color-theory-quiz",
          "day": 8,
          "title": "Color Theory Quiz",
          "goal": "HTML page that tests complementary / analogous / monochromatic color knowledge.",
          "hint": "Add JS so clicking an option adds class 'correct' when data-correct is true, else 'wrong'.",
          "starter": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<style>\nbody { font-family: system-ui; padding: 20px; }\n  .question { margin-bottom: 18px; }\n  .option { display: block; width: 100%; text-align: left; margin: 6px 0; padding: 8px 12px; border-radius: 8px; border: 1px solid #ccc; cursor: pointer; }\n  .option.correct { background: #0a7d4b; color: #fff; border-color: #0a7d4b; }\n  .option.wrong { background: #d64545; color: #fff; border-color: #d64545; }\n</style>\n</head>\n<body>\n<h2>Color theory quiz</h2>\n  <div class=\"question\" data-q=\"1\">\n    <p>What are two colors opposite each other on the color wheel called?</p>\n    <button class=\"option\" data-correct=\"true\">Complementary</button>\n    <button class=\"option\" data-correct=\"false\">Analogous</button>\n    <button class=\"option\" data-correct=\"false\">Monochromatic</button>\n  </div>\n  <div class=\"question\" data-q=\"2\">\n    <p>Which colors sit next to each other on the wheel and feel harmonious?</p>\n    <button class=\"option\" data-correct=\"false\">Complementary</button>\n    <button class=\"option\" data-correct=\"true\">Analogous</button>\n    <button class=\"option\" data-correct=\"false\">Triadic</button>\n  </div>\n  <div class=\"question\" data-q=\"3\">\n    <p>A color and its tints and shades make up which scheme?</p>\n    <button class=\"option\" data-correct=\"false\">Complementary</button>\n    <button class=\"option\" data-correct=\"false\">Analogous</button>\n    <button class=\"option\" data-correct=\"true\">Monochromatic</button>\n  </div>\n\n<script>\n// On click: an option gets class \"correct\" if data-correct=\"true\", else \"wrong\".\n\n</script>\n</body>\n</html>\n",
          "solution": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<style>\nbody { font-family: system-ui; padding: 20px; }\n  .question { margin-bottom: 18px; }\n  .option { display: block; width: 100%; text-align: left; margin: 6px 0; padding: 8px 12px; border-radius: 8px; border: 1px solid #ccc; cursor: pointer; }\n  .option.correct { background: #0a7d4b; color: #fff; border-color: #0a7d4b; }\n  .option.wrong { background: #d64545; color: #fff; border-color: #d64545; }\n</style>\n</head>\n<body>\n<h2>Color theory quiz</h2>\n  <div class=\"question\" data-q=\"1\">\n    <p>What are two colors opposite each other on the color wheel called?</p>\n    <button class=\"option\" data-correct=\"true\">Complementary</button>\n    <button class=\"option\" data-correct=\"false\">Analogous</button>\n    <button class=\"option\" data-correct=\"false\">Monochromatic</button>\n  </div>\n  <div class=\"question\" data-q=\"2\">\n    <p>Which colors sit next to each other on the wheel and feel harmonious?</p>\n    <button class=\"option\" data-correct=\"false\">Complementary</button>\n    <button class=\"option\" data-correct=\"true\">Analogous</button>\n    <button class=\"option\" data-correct=\"false\">Triadic</button>\n  </div>\n  <div class=\"question\" data-q=\"3\">\n    <p>A color and its tints and shades make up which scheme?</p>\n    <button class=\"option\" data-correct=\"false\">Complementary</button>\n    <button class=\"option\" data-correct=\"false\">Analogous</button>\n    <button class=\"option\" data-correct=\"true\">Monochromatic</button>\n  </div>\n\n<script>\n// On click: an option gets class \"correct\" if data-correct=\"true\", else \"wrong\".\n\ndocument.querySelectorAll(\".option\").forEach((opt) => {\n  opt.addEventListener(\"click\", () => {\n    const siblings = opt.closest(\".question\").querySelectorAll(\".option\");\n    siblings.forEach((o) => (o.className = \"option\"));\n    opt.className = opt.dataset.correct === \"true\" ? \"option correct\" : \"option wrong\";\n  });\n});\n</script>\n</body>\n</html>\n"
        },
        {
          "id": "palette-generator",
          "day": 9,
          "title": "Dynamic Palette Generator",
          "goal": "A button that generates random harmonious colors and writes them into CSS variables.",
          "hint": "On click, set --c1..--c5 on :root to hues near one random base hue (e.g. +0, 10, 20, 30, 40).",
          "starter": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<style>\n:root { --c1: #dddddd; --c2: #dddddd; --c3: #dddddd; --c4: #dddddd; --c5: #dddddd; }\n  body { font-family: system-ui; padding: 20px; }\n  .palette { display: flex; gap: 10px; margin-top: 12px; }\n  .swatch { flex: 1; height: 90px; border-radius: 10px; border: 1px solid #ccc; background: var(--c1); }\n  .swatch:nth-child(2) { background: var(--c2); }\n  .swatch:nth-child(3) { background: var(--c3); }\n  .swatch:nth-child(4) { background: var(--c4); }\n  .swatch:nth-child(5) { background: var(--c5); }\n</style>\n</head>\n<body>\n<button id=\"generate\">Generate palette</button>\n  <div class=\"palette\">\n    <div class=\"swatch\"></div><div class=\"swatch\"></div><div class=\"swatch\"></div>\n    <div class=\"swatch\"></div><div class=\"swatch\"></div>\n  </div>\n\n<script>\n// On click: pick a random base hue, then set --c1..--c5 to harmonious colors\n// (e.g. base + 0, 10, 20, 30, 40 degrees) on the :root element.\n\n</script>\n</body>\n</html>\n",
          "solution": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<style>\n:root { --c1: #dddddd; --c2: #dddddd; --c3: #dddddd; --c4: #dddddd; --c5: #dddddd; }\n  body { font-family: system-ui; padding: 20px; }\n  .palette { display: flex; gap: 10px; margin-top: 12px; }\n  .swatch { flex: 1; height: 90px; border-radius: 10px; border: 1px solid #ccc; background: var(--c1); }\n  .swatch:nth-child(2) { background: var(--c2); }\n  .swatch:nth-child(3) { background: var(--c3); }\n  .swatch:nth-child(4) { background: var(--c4); }\n  .swatch:nth-child(5) { background: var(--c5); }\n</style>\n</head>\n<body>\n<button id=\"generate\">Generate palette</button>\n  <div class=\"palette\">\n    <div class=\"swatch\"></div><div class=\"swatch\"></div><div class=\"swatch\"></div>\n    <div class=\"swatch\"></div><div class=\"swatch\"></div>\n  </div>\n\n<script>\n// On click: pick a random base hue, then set --c1..--c5 to harmonious colors\n// (e.g. base + 0, 10, 20, 30, 40 degrees) on the :root element.\n\ndocument.getElementById(\"generate\").addEventListener(\"click\", () => {\n  const base = Math.floor(Math.random() * 360);\n  const offsets = [0, 10, 20, 30, 40];\n  const root = document.documentElement;\n  offsets.forEach((off, i) => {\n    root.style.setProperty(\"--c\" + (i + 1), \"hsl(\" + ((base + off) % 360) + \" 70% 60%)\");\n  });\n});\n</script>\n</body>\n</html>\n"
        },
        {
          "id": "traffic-light",
          "day": 10,
          "title": "Traffic Light",
          "goal": "CSS-only animation cycling red -> yellow -> green.",
          "hint": "Add a @keyframes block with three color stops and an animation on .light.",
          "starter": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<style>\nbody { font-family: system-ui; padding: 20px; }\n  .traffic { width: 90px; padding: 14px; background: #16181f; border-radius: 14px; display: grid; gap: 12px; }\n  .light { height: 56px; border-radius: 50%; background: #000; }\n  /* Add @keyframes that cycle the .light through red -> yellow -> green,\n     then apply it with animation on .light. */\n</style>\n</head>\n<body>\n<div class=\"traffic\"><div class=\"light\"></div></div>\n</body>\n</html>\n",
          "solution": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<style>\nbody { font-family: system-ui; padding: 20px; }\n  .traffic { width: 90px; padding: 14px; background: #16181f; border-radius: 14px; display: grid; gap: 12px; }\n  .light { height: 56px; border-radius: 50%; background: #000; }\n  @keyframes cycle {\n    0%, 33% { background: red; }\n    66% { background: yellow; }\n    100% { background: green; }\n  }\n  .light { animation: cycle 3s infinite; }\n</style>\n</head>\n<body>\n<div class=\"traffic\"><div class=\"light\"></div></div>\n</body>\n</html>\n"
        },
        {
          "id": "mood-page",
          "day": 11,
          "title": "Mood Page",
          "goal": "One page, 4 themes switched via body classes (calm, angry, happy, night).",
          "hint": "On click, set body's class to the matching mood so the background changes.",
