      "challenges": [
        {
          "id": "color-naming",
          "day": 1,
          "title": "Color Naming",
          "goal": "Recreate 5 boxes using only named colors (red, teal, coral, navy, olive...).",
          "hint": "Give each .box a different CSS named color like red, teal, coral.",
          "starter": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<style>\nbody { font-family: system-ui; padding: 20px; }\n  .row { display: flex; gap: 12px; margin-top: 12px; }\n  .box { width: 80px; height: 80px; border-radius: 8px; border: 1px solid #ccc; }\n  /* Fill each box with a NAMED color (red, teal, coral, navy, olive...): */\n</style>\n</head>\n<body>\n<p>Five boxes, five different named colors</p>\n  <div class=\"row\">\n    <div class=\"box\"></div><div class=\"box\"></div><div class=\"box\"></div>\n    <div class=\"box\"></div><div class=\"box\"></div>\n  </div>\n</body>\n</html>\n",
          "solution": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<style>\nbody { font-family: system-ui; padding: 20px; }\n  .row { display: flex; gap: 12px; margin-top: 12px; }\n  .box { width: 80px; height: 80px; border-radius: 8px; border: 1px solid #ccc; }\n  .box:nth-child(1) { background: red; }\n  .box:nth-child(2) { background: teal; }\n  .box:nth-child(3) { background: coral; }\n  .box:nth-child(4) { background: navy; }\n  .box:nth-child(5) { background: olive; }\n</style>\n</head>\n<body>\n<p>Five boxes, five different named colors</p>\n  <div class=\"row\">\n    <div class=\"box\"></div><div class=\"box\"></div><div class=\"box\"></div>\n    <div class=\"box\"></div><div class=\"box\"></div>\n  </div>\n</body>\n</html>\n"
        },
        {
          "id": "hex-hunt",
          "day": 2,
          "title": "Hex Hunt",
          "goal": "Match 10 target colors using hex codes only. Each box carries its target in data-target.",
          "hint": "Set each box's background to the exact hex in its data-target attribute.",
          "starter": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<style>\nbody { font-family: system-ui; padding: 20px; }\n  .grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; }\n  .hex-box { height: 56px; border-radius: 8px; border: 1px solid #ccc; }\n  /* Set each box's background to exactly its data-target hex: */\n</style>\n</head>\n<body>\n<p>Match every swatch to its target hex</p>\n  <div class=\"grid\">\n    <div class=\"hex-box\" data-target=\"#e03a3a\"></div>\n    <div class=\"hex-box\" data-target=\"#e8833a\"></div>\n    <div class=\"hex-box\" data-target=\"#d8d83a\"></div>\n    <div class=\"hex-box\" data-target=\"#3ad87a\"></div>\n    <div class=\"hex-box\" data-target=\"#3ad8d8\"></div>\n    <div class=\"hex-box\" data-target=\"#3a7ad8\"></div>\n    <div class=\"hex-box\" data-target=\"#7a3ad8\"></div>\n    <div class=\"hex-box\" data-target=\"#d83ad8\"></div>\n    <div class=\"hex-box\" data-target=\"#d83a7a\"></div>\n    <div class=\"hex-box\" data-target=\"#6b7280\"></div>\n  </div>\n</body>\n</html>\n",
          "solution": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<style>\nbody { font-family: system-ui; padding: 20px; }\n  .grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; }\n  .hex-box { height: 56px; border-radius: 8px; border: 1px solid #ccc; }\n  .hex-box:nth-child(1) { background: #e03a3a; }\n  .hex-box:nth-child(2) { background: #e8833a; }\n  .hex-box:nth-child(3) { background: #d8d83a; }\n  .hex-box:nth-child(4) { background: #3ad87a; }\n  .hex-box:nth-child(5) { background: #3ad8d8; }\n  .hex-box:nth-child(6) { background: #3a7ad8; }\n  .hex-box:nth-child(7) { background: #7a3ad8; }\n  .hex-box:nth-child(8) { background: #d83ad8; }\n  .hex-box:nth-child(9) { background: #d83a7a; }\n  .hex-box:nth-child(10) { background: #6b7280; }\n</style>\n</head>\n<body>\n<p>Match every swatch to its target hex</p>\n  <div class=\"grid\">\n    <div class=\"hex-box\" data-target=\"#e03a3a\"></div>\n    <div class=\"hex-box\" data-target=\"#e8833a\"></div>\n    <div class=\"hex-box\" data-target=\"#d8d83a\"></div>\n    <div class=\"hex-box\" data-target=\"#3ad87a\"></div>\n    <div class=\"hex-box\" data-target=\"#3ad8d8\"></div>\n    <div class=\"hex-box\" data-target=\"#3a7ad8\"></div>\n    <div class=\"hex-box\" data-target=\"#7a3ad8\"></div>\n    <div class=\"hex-box\" data-target=\"#d83ad8\"></div>\n    <div class=\"hex-box\" data-target=\"#d83a7a\"></div>\n    <div class=\"hex-box\" data-target=\"#6b7280\"></div>\n  </div>\n</body>\n</html>\n"
        },
        {
          "id": "rgb-mixer",
          "day": 3,
          "title": "RGB Mixer",
          "goal": "Build a gradient using only rgb() values. No hex, no named colors.",
          "hint": "Give .gradient a linear-gradient with two rgb() color stops.",
          "starter": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<style>\nbody { font-family: system-ui; padding: 20px; }\n  .gradient { height: 120px; border-radius: 12px; }\n  /* Build a gradient from two rgb() stops, no hex or named colors: */\n</style>\n</head>\n<body>\n<p>Gradient with rgb() only</p>\n  <div class=\"gradient\"></div>\n</body>\n</html>\n",
          "solution": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<style>\nbody { font-family: system-ui; padding: 20px; }\n  .gradient { height: 120px; border-radius: 12px;\n    background: linear-gradient(90deg, rgb(255, 60, 60), rgb(60, 60, 255)); }\n</style>\n</head>\n<body>\n<p>Gradient with rgb() only</p>\n  <div class=\"gradient\"></div>\n</body>\n</html>\n"
        }
      ]
    },
    {
